@@ -0,0 +1,99 @@
+'use strict';
+(() => {
+  const errors = [];
+  const MAX_ERRORS = 20;
+  const addError = (message, source = 'runtime') => {
+    const item = { at: new Date().toISOString(), source, message: String(message || 'Неизвестная ошибка').slice(0, 1000) };
+    errors.unshift(item);
+    errors.splice(MAX_ERRORS);
+    try { sessionStorage.setItem('secondBrainOS.v96.lastErrors', JSON.stringify(errors)); } catch (_) {}
+  };
+  window.addEventListener('error', event => addError(event.error?.message || event.message, 'window.error'));
+  window.addEventListener('unhandledrejection', event => addError(event.reason?.message || event.reason, 'unhandledrejection'));
+
+  const storageSummary = () => {
+    let state = null;
+    try { state = JSON.parse(localStorage.getItem('secondBrainOS.v1') || 'null'); } catch (_) {}
+    const counts = {};
+    if (state && typeof state === 'object') {
+      for (const [key, value] of Object.entries(state)) if (Array.isArray(value)) counts[key] = value.length;
+    }
+    return {
+      dataKeyPresent: localStorage.getItem('secondBrainOS.v1') !== null,
+      bytes: new Blob([localStorage.getItem('secondBrainOS.v1') || '']).size,
+      counts
+    };
+  };
+
+  const report = async () => {
+    const registration = await navigator.serviceWorker?.getRegistration?.().catch?.(() => null);
+    return {
+      build: window.SecondBrainBuild || null,
+      storage: storageSummary(),
+      backup: window.SecondBrainBackup?.getStatus?.() || null,
+      cloud: window.SecondBrainCloud?.getStatus?.() || null,
+      pwa: {
+        supported: 'serviceWorker' in navigator,
+        controlled: Boolean(navigator.serviceWorker?.controller),
+        registered: Boolean(registration),
+        waiting: Boolean(registration?.waiting)
+      },
+      errors: [...errors]
+    };
+  };
+
+  const copyReport = async () => {
+    const text = JSON.stringify(await report(), null, 2);
+    try {
+      await navigator.clipboard.writeText(text);
+      window.SecondBrainApp?.toast?.('Технический отчёт скопирован');
+    } catch (_) {
+      const blob = new Blob([text], { type: 'application/json' });
+      const link = document.createElement('a');
+      link.href = URL.createObjectURL(blob);
+      link.download = `second-brain-diagnostics-${new Date().toISOString().slice(0, 10)}.json`;
+      link.click();
+      setTimeout(() => URL.revokeObjectURL(link.href), 1000);
+    }
+  };
+
+  const decorateSettings = async () => {
+    const page = document.querySelector('.v78-page');
+    if (!page || !/настройки/i.test(page.querySelector('h1')?.textContent || '') || page.querySelector('[data-v96-diagnostics]')) return;
+    const backup = window.SecondBrainBackup?.getStatus?.() || {};
+    const cloud = window.SecondBrainCloud?.getStatus?.() || {};
+    const card = document.createElement('section');
+    card.className = 'v96-diagnostics-card';
+    card.dataset.v96Diagnostics = 'true';
+    card.innerHTML = `
+      <header><div><small>ДИАГНОСТИКА</small><h2>Стабильность и сохранность</h2><p>Технические статусы без показа личных данных.</p></div><span>${window.SecondBrainBuild?.label || 'V96'}</span></header>
+      <div class="v96-diagnostics-grid">
+        <article><small>Основной ключ данных</small><b>${localStorage.getItem('secondBrainOS.v1') !== null ? 'Сохранён' : 'Пока пуст'}</b></article>
+        <article><small>Резервная копия V96</small><b>${backup.createdAt ? new Date(backup.createdAt).toLocaleString('ru-RU') : 'Создаётся'}</b></article>
+        <article><small>Облачная синхронизация</small><b>${cloud.status || 'Не настроена'}</b></article>
+        <article><small>Ошибки запуска</small><b>${errors.length}</b></article>
+      </div>
+      <button type="button" data-v96-action="copy-diagnostics">Скопировать технический отчёт</button>`;
+    page.appendChild(card);
+  };
+
+  document.addEventListener('click', event => {
+    const button = event.target.closest?.('[data-v96-action="copy-diagnostics"]');
+    if (!button) return;
+    event.preventDefault();
+    copyReport();
+  });
+
+  const observer = new MutationObserver(() => requestAnimationFrame(decorateSettings));
+  if (document.readyState === 'loading') {
+    document.addEventListener('DOMContentLoaded', () => {
+      observer.observe(document.documentElement, { childList: true, subtree: true });
+      decorateSettings();
+    }, { once: true });
+  } else {
+    observer.observe(document.documentElement, { childList: true, subtree: true });
+    decorateSettings();
+  }
+
+  window.SecondBrainDiagnostics = { report, copyReport, addError, getErrors: () => [...errors] };
+})();
