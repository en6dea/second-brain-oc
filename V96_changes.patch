diff --git mnt/data/v96_work/second-brain-oc-main/src/storage/backup.js mnt/data/v96_work/second-brain-oc-main/src/storage/backup.js
new file mode 100644
index 0000000..a1ff512
--- /dev/null
+++ mnt/data/v96_work/second-brain-oc-main/src/storage/backup.js
@@ -0,0 +1,101 @@
+'use strict';
+(() => {
+  const STORE_KEY = 'secondBrainOS.v1';
+  const MARKER_KEY = 'secondBrainOS.v96.backupCreated';
+  const RAW_BACKUP_KEY = 'secondBrainOS.v96.rawLocalBackup';
+  const DB_NAME = 'SecondBrainOSDurableStorage';
+  const DB_STORE = 'records';
+  const status = { attempted: false, created: false, createdAt: '', error: '' };
+
+  const openDb = () => new Promise((resolve, reject) => {
+    try {
+      const request = indexedDB.open(DB_NAME);
+      request.onupgradeneeded = () => {
+        if (!request.result.objectStoreNames.contains(DB_STORE)) request.result.createObjectStore(DB_STORE);
+      };
+      request.onsuccess = () => resolve(request.result);
+      request.onerror = () => reject(request.error || new Error('IndexedDB недоступна'));
+    } catch (error) { reject(error); }
+  });
+
+  const put = async (key, value) => {
+    const db = await openDb();
+    try {
+      await new Promise((resolve, reject) => {
+        const tx = db.transaction(DB_STORE, 'readwrite');
+        tx.objectStore(DB_STORE).put(value, key);
+        tx.oncomplete = resolve;
+        tx.onerror = () => reject(tx.error || new Error('Не удалось записать резервную копию'));
+        tx.onabort = () => reject(tx.error || new Error('Запись резервной копии отменена'));
+      });
+    } finally { db.close(); }
+  };
+
+  const countCollections = state => {
+    const result = {};
+    if (!state || typeof state !== 'object') return result;
+    for (const [key, value] of Object.entries(state)) if (Array.isArray(value)) result[key] = value.length;
+    return result;
+  };
+
+  async function create() {
+    status.attempted = true;
+    try {
+      const existing = localStorage.getItem(MARKER_KEY);
+      if (existing) {
+        status.created = true;
+        status.createdAt = existing;
+        return { ...status, reused: true };
+      }
+      let raw = localStorage.getItem(STORE_KEY);
+      const createdAt = new Date().toISOString();
+      let parsed = null;
+      if (raw) {
+        try { parsed = JSON.parse(raw); } catch (_) { parsed = null; }
+      } else {
+        const liveState = window.SecondBrainApp?.getState?.() || window.state || null;
+        if (liveState && typeof liveState === 'object' && Object.keys(liveState).length) {
+          parsed = liveState;
+          try { raw = JSON.stringify(liveState); } catch (_) { raw = null; }
+        }
+      }
+      if (!raw) {
+        status.error = 'Данные ещё не загружены';
+        return { ...status, retryable: true };
+      }
+      // Не удваиваем очень крупную базу в localStorage: полный снимок всё равно сохраняется в IndexedDB.
+      if (raw.length <= 1_500_000 && !localStorage.getItem(RAW_BACKUP_KEY)) {
+        localStorage.setItem(RAW_BACKUP_KEY, raw);
+      }
+      const payload = {
+        version: 96,
+        buildId: window.SecondBrainBuild?.id || 'second-brain-os-v96-stable-core',
+        dataSchemaVersion: parsed?.schemaVersion || 1,
+        createdAt,
+        reason: 'automatic-before-v96-stable-core',
+        sourceKey: STORE_KEY,
+        raw,
+        counts: countCollections(parsed)
+      };
+      await put(`backup:v96-before-stable-core:${createdAt}`, payload);
+      localStorage.setItem(MARKER_KEY, createdAt);
+      status.created = true;
+      status.createdAt = createdAt;
+      window.dispatchEvent(new CustomEvent('second-brain-backup-created', { detail: { createdAt } }));
+      return { ...status };
+    } catch (error) {
+      status.error = error?.message || String(error);
+      console.warn('[Second Brain V96 backup]', error);
+      return { ...status };
+    }
+  }
+
+  window.SecondBrainBackup = { create, getStatus: () => ({ ...status }) };
+  const schedule = () => {
+    setTimeout(create, 350);
+    setTimeout(() => { if (!status.created) create(); }, 1800);
+    setTimeout(() => { if (!status.created) create(); }, 5000);
+  };
+  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', schedule, { once: true });
+  else schedule();
+})();
